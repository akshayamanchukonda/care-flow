digraph AsIsHealthcareProcess {
    rankdir=LR;
    node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    edge [fontname="Helvetica", fontsize=9];

    START [shape=circle, fillcolor="#16A34A", fontcolor=white, style=filled, color="#15803D", label="START"];
    END [shape=doublecircle, fillcolor="#DC2626", fontcolor=white, style=filled, color="#991B1B", label="END"];

    "Registration" [label="Registration\n(527 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    "Triage" [label="Triage\n(527 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    "Consultation" [label="Consultation\n(616 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    "Diagnostics" [label="Diagnostics\n(331 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    "Treatment" [label="Treatment\n(529 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];
    "Discharge" [label="Discharge\n(500 events)", shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#0284C7", penwidth=2.0, fontname="Helvetica-Bold", fontsize=11];

    START -> "Registration" [label="500", color="#16A34A", penwidth=2.2];
    "Registration" -> "Triage" [label="527", color="#1E3A8A", penwidth=1.8];
    "Treatment" -> "Discharge" [label="500", color="#1E3A8A", penwidth=1.8];
    "Triage" -> "Consultation" [label="500", color="#1E3A8A", penwidth=1.8];
    "Consultation" -> "Treatment" [label="314", color="#1E3A8A", penwidth=1.8];
    "Consultation" -> "Diagnostics" [label="302", color="#1E3A8A", penwidth=1.8];
    "Diagnostics" -> "Treatment" [label="215", color="#1E3A8A", penwidth=1.8];
    "Diagnostics" -> "Consultation" [label="Loop: 116", color="#DC2626", style=dashed, penwidth=2.0, fontcolor="#DC2626"];
    "Treatment" -> "Diagnostics" [label="Loop: 29", color="#DC2626", style=dashed, penwidth=2.0, fontcolor="#DC2626"];
    "Triage" -> "Registration" [label="Loop: 27", color="#DC2626", style=dashed, penwidth=2.0, fontcolor="#DC2626"];
    "Discharge" -> END [label="500", color="#DC2626", penwidth=2.2];
}
